doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Blog | av.codes
    meta(name='description', content='Engineering notes, implementation stories, and practical write-ups from av.codes.')
    link(rel='canonical', href="https://av.codes/blog/")
    meta(property='og:type', content='website')
    meta(property='og:url', content="https://av.codes/blog/")
    meta(property='og:title', content='Blog | av.codes')
    meta(property='og:description', content='Engineering notes, implementation stories, and practical write-ups from av.codes.')
    meta(property='og:image', content="https://av.codes/og-image.png")
    meta(name='twitter:card', content='summary_large_image')
    meta(name='twitter:url', content="https://av.codes/blog/")
    meta(name='twitter:title', content='Blog | av.codes')
    meta(name='twitter:description', content='Engineering notes, implementation stories, and practical write-ups from av.codes.')
    meta(name='twitter:image', content="https://av.codes/og-image.png")
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin='')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap')
    link(rel='stylesheet', href='../main.scss')
    link(rel='stylesheet', href='../blog.scss')
  body.blog-page
    .blog-canvas
      main.blog-shell
        div(style="padding: 1rem;")
          a.blog-back-link(href='/') Back to home
          h1.blog-title(data-text='Blog') Blog
        ul.blog-post-list
          li
            a.blog-post-card(href="/blog/on-local-inference/")
              h2.blog-post-card__title On local inference
              p.blog-post-card__meta Jun 18, 2026 - llms, local-inference
              p.blog-post-card__description The unglamorous ongoing labor of keeping a private local inference rig running after the romance of self-hosting has worn thin.
          li
            a.blog-post-card(href="/blog/hyperscalers-are-4500-years-old/")
              h2.blog-post-card__title Hyperscalers are 4500 years old
              p.blog-post-card__meta May 2, 2026 - infrastructure, history
              p.blog-post-card__description The Great Pyramid and a hyperscale datacenter are structurally identical bets — concentrated short-term cost justified across a longer horizon.
          li
            a.blog-post-card(href="/blog/local-llms-history/")
              h2.blog-post-card__title A History of Local LLMs
              p.blog-post-card__meta Mar 20, 2026 - llms, dossier
              p.blog-post-card__description A detailed look at the timeline of local large language models.
      .grain-layer(aria-hidden='true')
