    {
      "title": "The laptop becomes a controller",
      "caption": "The MacBook stops doing the work. A Hetzner box, a Fedora workstation and a throwaway sandbox join over Tailscale, each running its own Kandev.",
      "ops": [
        {
          "op": "set",
          "group": "mac",
          "label": "MacBook · controller",
          "x": 30,
          "y": 30
        },
        {
          "op": "set",
          "group": "kandev-mac",
          "label": "Kandev · control"
        },
        {
          "op": "remove",
          "node": "agent-3"
        },
        {
          "op": "remove",
          "node": "agent-4"
        },
        {
          "op": "remove",
          "node": "av"
        },
        {
          "op": "remove",
          "node": "lifeos"
        },
        {
          "op": "set",
          "node": "kandev-1",
          "sublabel": "control plane"
        },
        {
          "op": "add",
          "group": {
            "id": "hetzner",
            "label": "Hetzner",
            "color": "tx2",
            "x": 74,
            "y": 30
          }
        },
        {
          "op": "add",
          "group": {
            "id": "fedora",
            "label": "Fedora",
            "color": "tx2",
            "x": 74,
            "y": 74
