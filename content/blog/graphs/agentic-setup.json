          "node": "ivan",
          "state": "error",
          "sublabel": "overloaded"
        },
        {
          "op": "set",
          "edge": "ivan->agent-1",
          "label": ""
        }
      ]
    },
    {
      "title": "Kandev takes the terminals",
      "caption": "Kandev becomes the surface: tasks in, sessions out, every agent in its own worktree. Ivan talks to one board instead of four shells.",
      "ops": [
        {
          "op": "add",
          "group": {
            "id": "kandev-mac",
            "label": "Kandev",
            "color": "tx3",
            "parent": "mac"
          }
        },
        {
          "op": "add",
          "node": {
            "id": "kandev-1",
            "label": "kandev",
            "sublabel": "board",
            "kind": "service",
            "color": "green",
            "size": 1.2,
            "group": "mac",
            "state": "active"
          }
        },
        {
          "op": "move",
          "node": "agent-1",
          "group": "kandev-mac"
        },
        {
          "op": "move",
          "node": "agent-2",
          "group": "kandev-mac"
        },
        {
          "op": "move",
          "node": "agent-3",
          "group": "kandev-mac"
        },
        {
          "op": "move",
          "node": "agent-4",
          "group": "kandev-mac"
        },
        {
          "op": "set",
          "node": "agent-1",
          "sublabel": "session"
        },
        {
          "op": "set",
          "node": "agent-2",
          "sublabel": "session"
        },
        {
          "op": "set",
          "node": "agent-3",
          "sublabel": "session"
        },
        {
          "op": "set",
          "node": "agent-4",
          "sublabel": "session"
        },
        {
          "op": "remove",
          "edge": "ivan->agent-1"
        },
        {
          "op": "remove",
          "edge": "ivan->agent-2"
        },
        {
          "op": "remove",
          "edge": "ivan->agent-3"
        },
        {
          "op": "remove",
          "edge": "ivan->agent-4"
        },
        {
          "op": "add",
          "edge": {
            "from": "ivan",
            "to": "kandev-1",
            "label": "tasks",
            "color": "tx2"
