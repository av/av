            "to": "kandev-1",
            "label": "reports",
            "color": "green",
            "style": "dashed",
            "state": "pending"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "sup-f",
            "to": "kandev-1",
            "color": "green",
            "style": "dashed",
            "state": "pending"
          }
        },
        {
          "op": "set",
          "node": "skills",
          "state": "default"
        },
        {
          "op": "set",
          "node": "agent-6",
          "state": "default"
        },
        {
          "op": "set",
          "edge": "ivan->kandev-1",
          "label": "goals"
        }
