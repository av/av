        {
          "op": "add",
          "node": {
            "id": "kandev-3",
            "label": "kandev",
            "kind": "service",
            "color": "green",
            "group": "fedora"
          }
        },
        {
          "op": "add",
          "node": {
            "id": "kandev-4",
            "label": "kandev",
            "kind": "service",
            "color": "green",
            "group": "sandbox",
