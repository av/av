{
  "trigger": "click",
  "interval": 2600,
  "aspect": 1.6,
  "seed": "agentic-setup",
  "steps": [
    {
      "title": "One machine, one agent",
      "caption": "It starts on a laptop. A single coding agent in a terminal, pointed at one repository.",
      "state": {
        "groups": [
          {
            "id": "mac",
            "label": "MacBook",
            "color": "tx2",
            "x": 50,
            "y": 50
          }
        ],
        "nodes": [
          {
            "id": "ivan",
            "label": "Ivan",
            "kind": "human",
            "color": "tx",
            "x": 14,
            "y": 50
          },
          {
            "id": "agent-1",
            "label": "claude",
            "sublabel": "terminal",
            "kind": "agent",
            "color": "green",
            "group": "mac"
          },
          {
            "id": "harbor",
            "label": "harbor",
            "kind": "repo",
            "color": "tx",
            "group": "mac"
          }
        ],
        "edges": [
          {
            "from": "ivan",
            "to": "agent-1",
            "label": "prompts",
            "color": "tx2"
          },
          {
            "from": "agent-1",
            "to": "harbor",
            "label": "edits",
            "color": "tx3"
          }
        ]
      }
    },
    {
      "title": "More agents than attention",
      "caption": "Soon there are four terminals and three repos. Every run needs a decision every couple of minutes, and the laptop is the only place they can happen.",
      "ops": [
        {
          "op": "add",
          "node": {
            "id": "agent-2",
            "label": "codex",
            "sublabel": "terminal",
            "kind": "agent",
            "color": "green",
            "group": "mac"
          }
        },
        {
          "op": "add",
          "node": {
            "id": "agent-3",
            "label": "claude",
            "sublabel": "terminal",
            "kind": "agent",
            "color": "green",
            "group": "mac"
          }
        },
        {
          "op": "add",
          "node": {
            "id": "agent-4",
            "label": "droid",
            "sublabel": "terminal",
            "kind": "agent",
            "color": "green",
            "group": "mac"
          }
        },
        {
          "op": "add",
          "node": {
            "id": "av",
            "label": "av.codes",
            "kind": "repo",
            "color": "tx",
            "group": "mac"
          }
        },
        {
          "op": "add",
          "node": {
            "id": "lifeos",
            "label": "lifeos",
            "kind": "repo",
            "color": "tx",
            "group": "mac"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "ivan",
            "to": "agent-2",
            "color": "tx2"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "ivan",
            "to": "agent-3",
            "color": "tx2"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "ivan",
            "to": "agent-4",
            "color": "tx2"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "agent-2",
            "to": "harbor",
            "color": "tx3"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "agent-3",
            "to": "av",
            "color": "tx3"
          }
        },
        {
          "op": "add",
          "edge": {
            "from": "agent-4",
            "to": "lifeos",
            "color": "tx3"
          }
        },
