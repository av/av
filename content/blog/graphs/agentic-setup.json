    {
      "title": "Agents supervise agents",
      "caption": "The next step is a supervisor session per machine. It watches the other sessions, retries stuck ones and reports to the controller, so Ivan reads summaries instead of logs.",
      "ops": [
        {
          "op": "add",
          "node": {
            "id": "sup-h",
            "label": "supervisor",
